# ---------------------------------------------------------------------------
# NOMAD environment
# Copy this file to .env.local and fill in the values you have.
# Any feature whose keys are missing stays visibly unconfigured in the UI —
# nothing is mocked or silently faked.
# ---------------------------------------------------------------------------

# Supabase project URL + anon (publishable) key — safe in the browser, RLS
# enforces access. Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public Mapbox token (pk.…) used for the map and for Search Box place search.
# Needs the default public scopes; URL restrictions must allow this origin.
# NEXT_PUBLIC_MAPBOX_TOKEN is still read as a fallback for older setups.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Server-only Google Gemini key for NOMAD AI. NEVER prefix with NEXT_PUBLIC.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Preferred model. Retired models answer 404, so the server falls back to a
# verified model automatically instead of failing the request.
GEMINI_MODEL=gemini-3.5-flash

# Canonical app origin used for auth redirects (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google OAuth (Supabase provider)
# ---------------------------------------------------------------------------
# This app never reads the Google client from .env — Supabase holds it
# server-side in Dashboard → Authentication → Providers → Google.
# The two names below exist only as a local reminder of what you paste there.
# Never prefix the secret with NEXT_PUBLIC_ and never commit a real value.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Authorised redirect URI to register in Google Cloud Console:
#   https://<project-ref>.supabase.co/auth/v1/callback
# App callback handled by Supabase afterwards:
#   http://localhost:3000/auth/callback   (development)
#   https://your-domain.com/auth/callback (production)

# The service-role key is intentionally not used anywhere in this project.
